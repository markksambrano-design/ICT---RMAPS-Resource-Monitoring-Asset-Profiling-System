-- ===============================================
-- 2. OFFICES TABLE
-- ===============================================
CREATE TABLE offices (
    id INT AUTO_INCREMENT PRIMARY KEY,
    office_name VARCHAR(150) NOT NULL UNIQUE,
    office_code VARCHAR(50),
    head_of_office VARCHAR(255),
    contact_number VARCHAR(50),
    office_email VARCHAR(100),
    category VARCHAR(50) DEFAULT 'other',
    date_submitted DATE,
    can_submit_forms TINYINT(1) DEFAULT 1,
    max_forms_per_year INT DEFAULT 1,
    max_equipment_units INT DEFAULT 0,
    created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP
);

